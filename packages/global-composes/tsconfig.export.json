{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"include": ["./src"],
	"exclude": ["./src/**/*.test.ts", "./src/**/*.bench.ts"],
	"compilerOptions": {
		"rootDir": "./src",
		"noEmit": false,
		"declaration": true,
		"declarationDir": "./dist",
		"emitDeclarationOnly": true
	}
}
